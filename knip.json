{
  "entry": [
    "src/**/*.test.ts",
    "src/production/*.ts",
    "src/service/*/main.ts",
    "src/signal-bot/main.ts",
    "src/local/*.ts",
    "src/scraper/*.ts",
    "src/scripts/*.ts",
    "src/reports/*.ts",
    "src/stats-dashboard/src/main.tsx",
    "src/everything-web/src/main.tsx",
    "src/analytics-dashboard/src/main.tsx",
    "src/analytics-dashboard/vite.config.ts",
    "src/everything-extension/entrypoints/**/*.{ts,tsx}",
    "src/everything-extension/wxt.config.ts",
    "src/everything-extension/tailwind.config.ts",
    "src/everything-extension/scripts/*.ts",
    "src/everything-web/tailwind.config.ts",
    "src/everything-storybook/shims/*.ts",
    "src/everything-storybook/tailwind.config.ts",
    "src/everything-storybook/manager.ts",
    "src/everything-storybook/preview.tsx"
  ],
  "project": [
    "src/**/*.{ts,tsx}"
  ],
  "ignore": [
    "src/scripts_jim/**",
    "src/scripts_nathan/**",
    "src/scripts_rob/**",
    "src/pipeline/misinfo-monitoring/**",
    "src/dashboard-shared/topicSets.ts",
    "src/dashboard-shared/CompetingNoteCard.tsx",
    "src/everything-core/database.types.ts"
  ],
  "ignoreDependencies": [
    "@types/p-queue",
    "papaparse",
    "@types/papaparse",
    "react-json-view-lite",
    "exa-js",
    "@wxt-dev/module-react"
  ],
  "ignoreUnresolved": [
    "#imports"
  ],
  "ignoreExportsUsedInFile": true,
  "exclude": [
    "types"
  ],
  "ignoreWorkspaces": [
    "src/review-dashboard"
  ],
  "storybook": {
    "config": [
      "src/everything-storybook/main.ts"
    ],
    "entry": [
      "src/**/*.stories.tsx"
    ]
  }
}
