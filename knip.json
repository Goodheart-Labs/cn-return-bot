{
  "entry": [
    "src/**/*.test.ts",
    "src/production/*.ts",
    "src/service/*/main.ts",
    "src/signal-bot/main.ts",
    "src/local/*.ts",
    "src/scraper/*.ts",
    "src/scripts/*.ts",
    "src/reports/*.ts",
    "src/review-dashboard/src/main.tsx",
    "src/review-dashboard/vite.config.ts",
    "src/everything-web/src/main.tsx",
    "src/everything-extension/entrypoints/**/*.{ts,tsx}",
    "src/everything-extension/wxt.config.ts",
    "src/everything-extension/tailwind.config.ts",
    "src/everything-extension/scripts/*.ts",
    "src/everything-web/tailwind.config.ts",
    "src/testPreload.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}"
  ],
  "ignore": [
    "src/scripts_jim/**",
    "src/scripts_nathan/**",
    "src/scripts_rob/**",
    "src/pipeline/misinfo-monitoring/**",
    "src/everything-core/database.types.ts"
  ],
  "ignoreDependencies": [
    "@types/p-queue",
    "exa-js",
    "@wxt-dev/module-react"
  ],
  "ignoreUnresolved": [
    "#imports"
  ],
  "ignoreExportsUsedInFile": true,
  "exclude": [
    "types"
  ]
}
