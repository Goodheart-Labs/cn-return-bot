+const TWO_LETTER_COUNTRY_CODE = /^[a-z]{2}$/;
+
+/**
+ * DataImpulse's residential proxy gateway. It gives every new connection a
+ * different device, so one fixed address serves every allocation. The country
+ * goes into the username as "__cr.<code>", which is DataImpulse's own syntax.
+ * Added by cn-return-bot (GOO-853); it is not part of upstream Jina Reader.
+ */
+export class DataImpulseProxyProvider {
+    baseProxyUrl: URL;
+
+    constructor(gatewayUrl: string) {
+        this.baseProxyUrl = new URL(gatewayUrl);
+    }
+
+    supports(countryCode: string) {
+        return countryCode === 'any' || TWO_LETTER_COUNTRY_CODE.test(countryCode);
+    }
+
+    async alloc(inputCountryCode?: string) {
+        const countryCode = inputCountryCode?.toLowerCase() || 'any';
+        const url = new URL(this.baseProxyUrl);
+        if (countryCode !== 'any' && countryCode !== 'auto') {
+            url.username = `${this.baseProxyUrl.username}__cr.${countryCode}`;
+        }
+        return url;
+    }
+}
