# The cn-walk service (GOO-791): keeps every walked creator's feed on a
# schedule and adds their new posts to the post list (src/walk/main.ts). A new
# unit is installed by hand once (ops/README.md); autodeploy restarts it after.
[Unit]
Description=Common Notes walk
After=network-online.target cn-fetch.service
Wants=network-online.target cn-fetch.service

[Service]
User=cnbot
WorkingDirectory=/opt/cn-return-bot
EnvironmentFile=/etc/cn-return-bot/service.env
Environment=PATH=/home/cnbot/.bun/bin:/home/cnbot/.local/bin:/usr/local/bin:/usr/bin:/bin
# Feeds and forum answers are fetched by the sandboxed fetcher, never in this
# process (ops/cn-fetch.service).
Environment=FETCH_SERVICE_SOCKET=/run/cn-fetch/fetch.sock
# The pages several readers opened (src/everything/demandQueue.ts). Unset
# means the defaults: 3 readers and 20 a day for text posts, 5 readers and 20
# a day for videos. 0 switches a kind off.
#Environment=EVERYTHING_DEMAND_TEXT_READERS=3
#Environment=EVERYTHING_DEMAND_TEXT_DAILY_CAP=20
#Environment=EVERYTHING_DEMAND_YOUTUBE_READERS=5
#Environment=EVERYTHING_DEMAND_YOUTUBE_DAILY_CAP=20
# A post already waiting on the list moves up at its 2nd reader, within the
# same daily caps. 0 switches a kind off.
#Environment=EVERYTHING_DEMAND_LISTED_TEXT_READERS=2
#Environment=EVERYTHING_DEMAND_LISTED_YOUTUBE_READERS=2
# The creators below the walk's bar whose posts are listed too, below every
# walked creator's (kindsBelowBar in src/walk/feedSchedule.ts). Unset means
# the text kinds. Add youtube for the channels; 0 switches it off.
#Environment=EVERYTHING_WALK_BELOW_BAR=substack,lesswrong
ExecStart=/home/cnbot/.bun/bin/bun run src/walk/main.ts
Restart=always
RestartSec=5
PrivateTmp=yes
# No process in this service may talk to a link-local address, where the cloud
# provider's metadata service lives.
IPAddressDeny=link-local

[Install]
WantedBy=multi-user.target
