# The cn-notify service: posts good Common Notes to Slack (GOO-228). Installed
# by ops/setup-vm.sh; the environment file is written by hand once, see
# ops/README.md.
[Unit]
Description=Common Notes Slack announcements
After=network-online.target
Wants=network-online.target

[Service]
User=cnbot
WorkingDirectory=/opt/cn-return-bot
EnvironmentFile=/etc/cn-return-bot/service.env
Environment=PATH=/home/cnbot/.bun/bin:/home/cnbot/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/cnbot/.bun/bin/bun run src/service/notify/main.ts
Restart=always
# Every start reads the database. A minute between restarts keeps a crash loop,
# for example after Slack refuses a channel, from hammering it.
RestartSec=60
PrivateTmp=yes
IPAddressDeny=link-local

[Install]
WantedBy=multi-user.target
