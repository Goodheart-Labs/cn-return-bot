# The retired cn-notify service, which posted Common Notes to four Slack
# channels (GOO-228) until GOO-452 removed it on 2026-10-16. Its code is gone.
# This file stays for one deploy only. The deploy that removes cn-notify runs
# the previous ops/autodeploy.sh, which still copies this file and stops when it
# is missing. Delete it in the next pull request.
[Unit]
Description=Common Notes Slack announcements
After=network-online.target
Wants=network-online.target

[Service]
User=cnbot
WorkingDirectory=/opt/cn-return-bot
EnvironmentFile=/etc/cn-return-bot/service.env
Environment=PATH=/home/cnbot/.bun/bin:/home/cnbot/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/cnbot/.bun/bin/bun run src/service/notify/main.ts
Restart=always
# Every start reads the database. A minute between restarts keeps a crash loop,
# for example after Slack refuses a channel, from hammering it.
RestartSec=60
PrivateTmp=yes
IPAddressDeny=link-local

[Install]
WantedBy=multi-user.target
