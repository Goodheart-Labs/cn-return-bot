# The cn-intake service. Installed by ops/setup-vm.sh; the environment file is
# written by hand once, see ops/README.md.
[Unit]
Description=Common Notes intake service
After=network-online.target
Wants=network-online.target

[Service]
User=cnbot
WorkingDirectory=/opt/cn-return-bot
EnvironmentFile=/etc/cn-return-bot/service.env
Environment=PATH=/home/cnbot/.bun/bin:/home/cnbot/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/cnbot/.bun/bin/bun run src/service/intake/main.ts
Restart=always
RestartSec=5
# Each service gets its own private /tmp, wiped on restart, so a long-lived
# machine never collects yt-dlp and browser leftovers.
PrivateTmp=yes
# No process in this service may talk to a link-local address. That range
# holds the cloud provider's metadata service, which describes the machine and
# is reachable from inside it only. The rule sits in the kernel, so it also
# covers the headless browser and yt-dlp, and every redirect they follow.
IPAddressDeny=link-local

[Install]
WantedBy=multi-user.target
