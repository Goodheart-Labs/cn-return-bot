# The daily site checks (GOO-804, src/site-checks/). cn-site-checks.timer
# starts this every night at 22:00 UTC, an hour before the devbox's CI checker
# Claude reads the report. It builds the extension against production, runs
# every check, and saves the report in the table site_check_runs. Installed by
# hand once (ops/README.md). After that autodeploy keeps this file current, but
# not the timer.
[Unit]
Description=Common Notes daily site checks
After=network-online.target cn-extraction.service
Wants=network-online.target

[Service]
Type=oneshot
User=cnbot
WorkingDirectory=/opt/cn-return-bot
EnvironmentFile=/etc/cn-return-bot/service.env
Environment=PATH=/home/cnbot/.bun/bin:/home/cnbot/.local/bin:/usr/local/bin:/usr/bin:/bin
# The anon key is the public key that every copy of the extension carries.
ExecStartPre=/usr/bin/env VITE_SUPABASE_URL=${SUPABASE_URL} VITE_SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY} /home/cnbot/.bun/bin/bun run build-ext-dev
ExecStart=/home/cnbot/.bun/bin/bun run site-checks --save
# A slow night with many retries takes about 40 minutes.
TimeoutStartSec=90min
PrivateTmp=yes
# No process in this service may talk to a link-local address, where the cloud
# provider's metadata service lives.
IPAddressDeny=link-local
