# Community Notes Bot - Environment Variables
# Copy this file to .env.local and fill in your values

# ===================
# REQUIRED - Core API
# ===================

# OpenRouter API key for LLM calls (Claude, etc.)
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# X/Twitter OAuth1 credentials
# Get these from https://developer.twitter.com/en/portal/dashboard
X_API_KEY=
X_API_KEY_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Supabase for data storage
# Get these from your Supabase project settings
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ===================
# OPTIONAL - Logging
# ===================

# Airtable for logging (optional, can be omitted)
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=

# ===================
# OPTIONAL - Search
# ===================

# Serper API for Google search (used by multi-search bot)
# Get one at https://serper.dev
SERPER_API_KEY=

# Exa API for neural search (used by multi-search bot)
# Get one at https://exa.ai
EXA_API_KEY=

# ===================
# AUTO-SET BY CI
# ===================

# Git commit SHA (auto-set by GitHub Actions)
# GITHUB_SHA=
