# Community Notes Bot - Environment Variables
# Copy this file to .env and fill in your values

OPENROUTER_API_KEY=

X_API_KEY=
X_API_KEY_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Signal group bot (scripts/signal-bot/README.md). Reuse a linked account or a dedicated bot.
SIGNAL_API_URL=http://127.0.0.1:8080
SIGNAL_NUMBER=
SIGNAL_GROUP_ID=
# Optional: the bot account UUID, for filtering its own messages.
SIGNAL_BOT_UUID=
# Enable when reusing your own account so messages from your phone are handled.
# Bot replies are filtered using a durable output ledger to prevent loops.
SIGNAL_ACCEPT_SELF_MESSAGES=false
# Optional: private durable state; defaults to output/signal-bot.sqlite.
SIGNAL_STATE_PATH=

# Everything-notes frontend (src/everything-web) — anon key is public by design,
# locked down by migration 050. Point at local or prod depending on what you test.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Analytics needs no extra vars: events are rows in everything_events, written
# through the anon key above to whatever backend VITE_SUPABASE_URL points at.


# Optional
LOCAL_X_API_KEY=
LOCAL_X_API_KEY_SECRET=
LOCAL_X_ACCESS_TOKEN=
LOCAL_X_ACCESS_TOKEN_SECRET=
X_NATHANPMYOUNG_API_KEY=
X_NATHANPMYOUNG_API_KEY_SECRET=
X_NATHANPMYOUNG_ACCESS_TOKEN=
X_NATHANPMYOUNG_ACCESS_TOKEN_SECRET=

LOCAL_SUPABASE_URL=http://127.0.0.1:54321
LOCAL_SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU # gitleaks:allow — public Supabase local-dev demo key

SERPER_API_KEY=
EXA_API_KEY=

ANTHROPIC_API_KEY=
