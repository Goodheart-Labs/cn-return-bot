# Community Notes Bot - Environment Variables
# Copy this file to .env.local and fill in your values

# ===================
# REQUIRED - Core API
# ===================

# OpenRouter API key for LLM calls (Claude, etc.)
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# X/Twitter OAuth1 credentials
# Get these from https://developer.twitter.com/en/portal/dashboard
X_API_KEY=
X_API_KEY_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# X/Twitter OAuth1 credentials from Nathans account. Used for tryoutNotes.ts
# Get these from https://developer.twitter.com/en/portal/dashboard
X_NATHANPMYOUNG_API_KEY=
X_NATHANPMYOUNG_API_KEY_SECRET=
X_NATHANPMYOUNG_ACCESS_TOKEN=
X_NATHANPMYOUNG_ACCESS_TOKEN_SECRET=

# Supabase for data storage
# Get these from your Supabase project settings
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ===================
# OPTIONAL - Search
# ===================

# Serper API for Google search (used by multi-search bot)
# Get one at https://serper.dev
SERPER_API_KEY=

# Exa API for neural search (used by multi-search bot)
# Get one at https://exa.ai
EXA_API_KEY=

# ============================
# LOCAL SUPABASE (for tryouts)
# ============================

# Start with: bash scripts/local-supabase.sh
LOCAL_SUPABASE_URL=http://127.0.0.1:54321
LOCAL_SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

ANTHROPIC_API_KEY=
GEMINI_API_KEY=

