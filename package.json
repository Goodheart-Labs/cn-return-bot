{
  "dependencies": {
    "@ai-sdk/openai": "^1.3.23",
    "@ai-sdk/xai": "^3.0.56",
    "@supabase/supabase-js": "^2.47.0",
    "@tonerow/agent-framework": "0.1.0",
    "@types/p-queue": "^3.2.1",
    "ai": "^4",
    "axios": "^1.10.0",
    "dotenv": "^17.2.1",
    "oauth-1.0a": "^2.2.6",
    "openai": "^5.10.1",
    "p-queue": "^8.1.0",
    "papaparse": "^5.5.3",
    "playwright": "^1.54.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-json-view-lite": "^2.5.0",
    "zod": "^4.0.5"
  },
  "name": "community-notes-writer",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/bun": "^1.2.23",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "husky": "^9.1.7",
    "knip": "^5.87.0",
    "puppeteer-core": "^24.39.1",
    "typescript": "5.9.3",
    "vite": "^8.0.3"
  },
  "scripts": {
    "typecheck": "bunx --bun typescript@5.9.3 --noEmit 2>&1 | grep -v 'node_modules/' | grep -q 'error TS' && exit 1 || exit 0",
    "check": "bun run typecheck && bunx knip",
    "prepare": "husky",
    "update-feedback": "bun run src/production/updateNoteFeedback.ts",
    "build-elo": "cd src/elo-rating-web && bun build ./app.ts ./airtableClient.ts ./eloCalculator.ts ./types.ts ./cacheManager.ts --outdir ./dist --target browser",
    "serve-elo": "bun run src/elo-rating-web/server.ts",
    "elo": "bun run build-elo && bun run serve-elo",
    "dev-review": "cd src/review-dashboard && bunx vite --port 8001",
    "build-review": "cd src/review-dashboard && bunx vite build",
    "serve-review": "bun run src/review-dashboard/server.ts",
    "review": "bun run build-review && bun run serve-review"
  }
}
