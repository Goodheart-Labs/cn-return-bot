{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "bun",
      "request": "launch",
      "name": "Debug Current File",
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "stopOnEntry": false
    },
    {
      "type": "bun",
      "request": "launch",
      "name": "Debug Pipeline",
      "program": "src/production/runPipeline.ts",
      "args": ["--local"],
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "bun",
      "request": "launch",
      "name": "Debug Everything Item",
      "program": "src/everything/debug/debugItem.ts",
      "args": ["https://thezvi.substack.com/p/twitter-thoughts-for-you", "--claim", "0"],
      "cwd": "${workspaceFolder}",
      "stopOnEntry": false
    }
  ],
  "workbench.editor.focusRecentEditorAfterClose": false
}